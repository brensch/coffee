name "cold-junction sensor stops answering: no compensation, so no heat"
machine "../models/gaggia_classic_pro_e24_120v.toml"
duration 12min

when engine.state == ready for 20s as warm: set probe.fault = cj_dead
at warm+60s: set probe.fault = ok

expect eventually engine.faults has cold_junction from warm by warm+3s
expect always heater.power == 0 from warm+3s until warm+60s
expect eventually engine.state == heating or engine.state == ready from warm+61s by warm+63s
expect always boiler.temp < 110
