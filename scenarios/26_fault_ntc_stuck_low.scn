name "probe reading freezes a few degrees under setpoint: energy-balance heater check"
machine "../models/gaggia_classic_pro_e24_230v.toml"
duration 12min

# The reading sticks at ~89 C during warm-up (setpoint 93). A plain PID then keeps adding heat the
# reading never shows, and the boiler climbs to the steam thermostat in brew mode. The heat delivered
# minus the most the boiler can lose must show up as a rise; it doesn't, so HEATER_INEFFECTIVE.
when engine.temp > 89 for 0s as frozen: set ntc.fault = stuck

expect eventually engine.faults has heater_ineffective from frozen by frozen+330s
expect always boiler.temp < 160
expect at frozen+350s: heater.power == 0
