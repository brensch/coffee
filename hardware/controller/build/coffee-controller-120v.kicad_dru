(version 1)
(rule "MAINS: 2.0 mm between mains nets (IEC 60664 functional, 120 V: ~1.6 mm)"
  (condition "(A.NetName == 'AC_L' || A.NetName == 'AC_L_FUSED' || A.NetName == 'AC_N' || A.NetName == 'HEATER_GATE' || A.NetName == 'HEATER_OPTO' || A.NetName == 'HTR_A' || A.NetName == 'HTR_B' || A.NetName == 'PUMP_GATE' || A.NetName == 'PUMP_L' || A.NetName == 'PUMP_OPTO' || A.NetName == 'PUMP_SNUB' || A.NetName == 'VALVE_GATE' || A.NetName == 'VALVE_L' || A.NetName == 'VALVE_OPTO' || A.NetName == 'VALVE_SNUB') && (B.NetName == 'AC_L' || B.NetName == 'AC_L_FUSED' || B.NetName == 'AC_N' || B.NetName == 'HEATER_GATE' || B.NetName == 'HEATER_OPTO' || B.NetName == 'HTR_A' || B.NetName == 'HTR_B' || B.NetName == 'PUMP_GATE' || B.NetName == 'PUMP_L' || B.NetName == 'PUMP_OPTO' || B.NetName == 'PUMP_SNUB' || B.NetName == 'VALVE_GATE' || B.NetName == 'VALVE_L' || B.NetName == 'VALVE_OPTO' || B.NetName == 'VALVE_SNUB')")
  (constraint clearance (min 2.0mm)))
(rule "MAINS: pins of one part (manufacturer's pitch)"
  (condition "(A.NetName == 'AC_L' || A.NetName == 'AC_L_FUSED' || A.NetName == 'AC_N' || A.NetName == 'HEATER_GATE' || A.NetName == 'HEATER_OPTO' || A.NetName == 'HTR_A' || A.NetName == 'HTR_B' || A.NetName == 'PUMP_GATE' || A.NetName == 'PUMP_L' || A.NetName == 'PUMP_OPTO' || A.NetName == 'PUMP_SNUB' || A.NetName == 'VALVE_GATE' || A.NetName == 'VALVE_L' || A.NetName == 'VALVE_OPTO' || A.NetName == 'VALVE_SNUB') && (B.NetName == 'AC_L' || B.NetName == 'AC_L_FUSED' || B.NetName == 'AC_N' || B.NetName == 'HEATER_GATE' || B.NetName == 'HEATER_OPTO' || B.NetName == 'HTR_A' || B.NetName == 'HTR_B' || B.NetName == 'PUMP_GATE' || B.NetName == 'PUMP_L' || B.NetName == 'PUMP_OPTO' || B.NetName == 'PUMP_SNUB' || B.NetName == 'VALVE_GATE' || B.NetName == 'VALVE_L' || B.NetName == 'VALVE_OPTO' || B.NetName == 'VALVE_SNUB') && ((A.insideCourtyard('Q1') && B.insideCourtyard('Q1')) || (A.insideCourtyard('Q2') && B.insideCourtyard('Q2')) || (A.insideCourtyard('Q3') && B.insideCourtyard('Q3')) || (A.insideCourtyard('U1') && B.insideCourtyard('U1')) || (A.insideCourtyard('U2') && B.insideCourtyard('U2')) || (A.insideCourtyard('U3') && B.insideCourtyard('U3')) || (A.insideCourtyard('PS1') && B.insideCourtyard('PS1')))")
  (constraint clearance (min 0.5mm)))
(rule "MAINS: same-potential pairs"
  (condition "(A.NetName == 'AC_L' && B.NetName == 'PUMP_OPTO') || (A.NetName == 'PUMP_OPTO' && B.NetName == 'AC_L') || (A.NetName == 'AC_L' && B.NetName == 'VALVE_OPTO') || (A.NetName == 'VALVE_OPTO' && B.NetName == 'AC_L') || (A.NetName == 'AC_L' && B.NetName == 'PUMP_SNUB') || (A.NetName == 'PUMP_SNUB' && B.NetName == 'AC_L') || (A.NetName == 'AC_L' && B.NetName == 'VALVE_SNUB') || (A.NetName == 'VALVE_SNUB' && B.NetName == 'AC_L') || (A.NetName == 'PUMP_OPTO' && B.NetName == 'VALVE_OPTO') || (A.NetName == 'VALVE_OPTO' && B.NetName == 'PUMP_OPTO') || (A.NetName == 'PUMP_OPTO' && B.NetName == 'PUMP_SNUB') || (A.NetName == 'PUMP_SNUB' && B.NetName == 'PUMP_OPTO') || (A.NetName == 'PUMP_OPTO' && B.NetName == 'VALVE_SNUB') || (A.NetName == 'VALVE_SNUB' && B.NetName == 'PUMP_OPTO') || (A.NetName == 'VALVE_OPTO' && B.NetName == 'PUMP_SNUB') || (A.NetName == 'PUMP_SNUB' && B.NetName == 'VALVE_OPTO') || (A.NetName == 'VALVE_OPTO' && B.NetName == 'VALVE_SNUB') || (A.NetName == 'VALVE_SNUB' && B.NetName == 'VALVE_OPTO') || (A.NetName == 'PUMP_SNUB' && B.NetName == 'VALVE_SNUB') || (A.NetName == 'VALVE_SNUB' && B.NetName == 'PUMP_SNUB') || (A.NetName == 'PUMP_L' && B.NetName == 'PUMP_GATE') || (A.NetName == 'PUMP_GATE' && B.NetName == 'PUMP_L') || (A.NetName == 'VALVE_L' && B.NetName == 'VALVE_GATE') || (A.NetName == 'VALVE_GATE' && B.NetName == 'VALVE_L') || (A.NetName == 'HTR_A' && B.NetName == 'HEATER_GATE') || (A.NetName == 'HEATER_GATE' && B.NetName == 'HTR_A') || (A.NetName == 'HTR_B' && B.NetName == 'HEATER_OPTO') || (A.NetName == 'HEATER_OPTO' && B.NetName == 'HTR_B')")
  (constraint clearance (min 0.5mm)))
