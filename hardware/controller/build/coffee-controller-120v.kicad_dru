(version 1)
(rule "MAINS: 2.0 mm between mains nets (IEC 60664 functional, 120 V: ~1.6 mm)"
  (condition "(A.NetName == 'AC_L' || A.NetName == 'AC_L_F' || A.NetName == 'AC_N' || A.NetName == 'PUMP_G' || A.NetName == 'PUMP_O6' || A.NetName == 'PUMP_SNUB' || A.NetName == 'PUMP_SW' || A.NetName == 'VALVE_G' || A.NetName == 'VALVE_O6' || A.NetName == 'VALVE_SNUB' || A.NetName == 'VALVE_SW') && (B.NetName == 'AC_L' || B.NetName == 'AC_L_F' || B.NetName == 'AC_N' || B.NetName == 'PUMP_G' || B.NetName == 'PUMP_O6' || B.NetName == 'PUMP_SNUB' || B.NetName == 'PUMP_SW' || B.NetName == 'VALVE_G' || B.NetName == 'VALVE_O6' || B.NetName == 'VALVE_SNUB' || B.NetName == 'VALVE_SW')")
  (constraint clearance (min 2.0mm)))
(rule "MAINS: pins of one part (manufacturer's pitch)"
  (condition "(A.NetName == 'AC_L' || A.NetName == 'AC_L_F' || A.NetName == 'AC_N' || A.NetName == 'PUMP_G' || A.NetName == 'PUMP_O6' || A.NetName == 'PUMP_SNUB' || A.NetName == 'PUMP_SW' || A.NetName == 'VALVE_G' || A.NetName == 'VALVE_O6' || A.NetName == 'VALVE_SNUB' || A.NetName == 'VALVE_SW') && (B.NetName == 'AC_L' || B.NetName == 'AC_L_F' || B.NetName == 'AC_N' || B.NetName == 'PUMP_G' || B.NetName == 'PUMP_O6' || B.NetName == 'PUMP_SNUB' || B.NetName == 'PUMP_SW' || B.NetName == 'VALVE_G' || B.NetName == 'VALVE_O6' || B.NetName == 'VALVE_SNUB' || B.NetName == 'VALVE_SW') && ((A.insideCourtyard('U8') && B.insideCourtyard('U8')) || (A.insideCourtyard('U9') && B.insideCourtyard('U9')) || (A.insideCourtyard('Q5') && B.insideCourtyard('Q5')) || (A.insideCourtyard('Q6') && B.insideCourtyard('Q6')) || (A.insideCourtyard('F1') && B.insideCourtyard('F1')))")
  (constraint clearance (min 0.5mm)))
(rule "MAINS: same-potential pairs"
  (condition "(A.NetName == 'AC_L' && B.NetName == 'AC_L_F') || (A.NetName == 'AC_L_F' && B.NetName == 'AC_L') || (A.NetName == 'AC_L_F' && B.NetName == 'PUMP_O6') || (A.NetName == 'PUMP_O6' && B.NetName == 'AC_L_F') || (A.NetName == 'AC_L_F' && B.NetName == 'PUMP_SNUB') || (A.NetName == 'PUMP_SNUB' && B.NetName == 'AC_L_F') || (A.NetName == 'PUMP_SW' && B.NetName == 'PUMP_G') || (A.NetName == 'PUMP_G' && B.NetName == 'PUMP_SW') || (A.NetName == 'AC_L_F' && B.NetName == 'VALVE_O6') || (A.NetName == 'VALVE_O6' && B.NetName == 'AC_L_F') || (A.NetName == 'AC_L_F' && B.NetName == 'VALVE_SNUB') || (A.NetName == 'VALVE_SNUB' && B.NetName == 'AC_L_F') || (A.NetName == 'VALVE_SW' && B.NetName == 'VALVE_G') || (A.NetName == 'VALVE_G' && B.NetName == 'VALVE_SW')")
  (constraint clearance (min 0.5mm)))
